# ── AST CodePath — Environment Variables ─────────────────────────────────────
# Copy this to .env.local for local development
# Add ALL of these as Environment Variables in your Render dashboard

# ── Database (PostgreSQL on Render) ──────────────────────────────────────────
# Get this from: Render Dashboard → PostgreSQL → Connection → External Database URL
DATABASE_URL=postgresql://user:password@host:5432/ast_codepath

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate a random secret: run this in terminal → openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string-here
# Your Render app URL (set automatically once deployed)
NEXTAUTH_URL=https://your-app-name.onrender.com

# ── Anthropic AI Agent ────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ── Cloudflare Stream (for video hosting) ────────────────────────────────────
# Get from: dash.cloudflare.com → Stream → API Tokens
# These are NOT needed for the iframe embed player — only for signed URLs later
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_STREAM_TOKEN=your-api-token

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app-name.onrender.com
