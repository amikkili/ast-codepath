// prisma/schema.prisma  ← REPLACE entire file
// ADDED: Certificate model to store issued certificates

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  BASIC
  PRO
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id               String               @id @default(cuid())
  name             String
  email            String               @unique
  password         String
  plan             Plan                 @default(FREE)
  role             Role                 @default(STUDENT)
  stripeCustomerId String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  progress         Progress[]
  resetTokens      PasswordResetToken[]
  certificates     Certificate[]        // ← NEW
}

// ── NEW: stores issued certificates ──────────────────────────────────────────
model Certificate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  courseName  String
  issuedAt    DateTime @default(now())

  @@unique([userId, courseId])   // one certificate per student per course
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Course {
  id          String   @id @default(cuid())
  title       String
  language    String
  color       String   @default("#534AB7")
  level       String   @default("Beginner")
  description String
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]
}

model Lesson {
  id         String     @id @default(cuid())
  courseId   String
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonNo   Int
  title      String
  duration   String     @default("10 min")
  videoId    String
  accessPlan Plan       @default(BASIC)
  published  Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  progress   Progress[]

  @@unique([courseId, lessonNo])
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  done      Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
}
